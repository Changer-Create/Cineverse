-  const VERIFIED_QUOTE_LIBRARY=[{"id":"P001","type":"filmmaker_quote","textZh":"诗意的联系，在我看来最适合电影——这种最真实、也最富诗性的艺术形式。","author":"安德烈·塔可夫斯基","film":null,"character":null,"category":"电影本体","verification":"B","sourceTitle":"BFI｜The Tarkovsky legacy","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/features/tarkovsky-legacy","sourceType":"著作引录","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P002","type":"filmmaker_quote","textZh":"我觉得，电影曾经比今天更接近梦。","author":"罗伯特·奥特曼","film":null,"character":null,"category":"梦与电影","verification":"A","sourceTitle":"BFI｜Robert Altman interview","sourceUrl":"https://www.bfi.org.uk/interviews/robert-altman-interview","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P003","type":"filmmaker_quote","textZh":"但在电影院里，我没那么孤独。","author":"席琳·席安玛","film":null,"character":null,"category":"观看与生活","verification":"A","sourceTitle":"BFI｜Céline Sciamma on cinema utopia","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/dream-palaces/celine-sciamma-on-cinema-utopia","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P004","type":"filmmaker_quote","textZh":"我不会先制定一种道德立场，再去拍一部电影。","author":"萨蒂亚吉特·雷伊","film":null,"character":null,"category":"创作","verification":"A","sourceTitle":"BFI｜Satyajit Ray: a moral attitude","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/satyajit-ray-moral-attitude","sourceType":"长期访谈整理","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P005","type":"filmmaker_quote","textZh":"从福特那里，你会慢慢明白什么时候不该剪。","author":"马丁·斯科塞斯","film":null,"character":null,"category":"剪辑","verification":"A","sourceTitle":"BFI｜Martin Scorsese interview","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/martin-scorsese-king-comedy","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P006","type":"filmmaker_quote","textZh":"故事并不一定非要从头到尾顺着讲。","author":"克里斯托弗·诺兰","film":null,"character":null,"category":"叙事","verification":"A","sourceTitle":"BFI｜Christopher Nolan: a showman's odyssey","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/christopher-nolan-showmans-odyssey-oppenheimer","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P007","type":"filmmaker_quote","textZh":"电影里你展示的，就是你交给观众的全部现实。","author":"马修·卡索维茨","film":null,"character":null,"category":"现实与电影","verification":"A","sourceTitle":"BFI｜Mathieu Kassovitz on La Haine","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/mathieu-kassovitz-la-haine-legacy","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P008","type":"filmmaker_quote","textZh":"我认为，革命电影的未来是一种业余电影。","author":"让-吕克·戈达尔","film":null,"character":null,"category":"电影本体","verification":"A","sourceTitle":"BFI｜Jean-Luc Godard interview","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/jean-luc-godard-la-chinoise-usa","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P009","type":"filmmaker_quote","textZh":"电影是一种颠覆性的方式，它改变了我的生活。","author":"阿尔伯特·塞拉","film":null,"character":null,"category":"电影与生活","verification":"A","sourceTitle":"BFI｜Albert Serra interview","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/albert-serra-i-am-best-one","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P010","type":"filmmaker_quote","textZh":"电影仍是一门年轻的艺术。一百三十年算不了什么。","author":"蒂耶里·弗雷莫","film":null,"character":null,"category":"电影史","verification":"A","sourceTitle":"Criterion｜Lumière! Le Cinéma: a conversation with Thierry Frémaux","sourceUrl":"https://www.criterion.com/current/posts/9158-lumiere-le-cinema-a-conversation-with-thierry-fremaux","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P011","type":"filmmaker_quote","textZh":"我记录观看这个行为，也记录光带给我的一切。","author":"斯坦·布拉哈格","film":null,"character":null,"category":"观看","verification":"B","sourceTitle":"Criterion｜Adventures in Perception: Stan Brakhage in His Own Words","sourceUrl":"https://www.criterion.com/current/posts/4956-adventures-in-perception-stan-brakhage-in-his-own-words","sourceType":"访谈整理","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P012","type":"filmmaker_quote","textZh":"我从不会只是为了拍一部电影而去拍电影。","author":"汤姆·克鲁斯","film":null,"character":null,"category":"创作","verification":"A","sourceTitle":"BFI｜Mission Statement: the Tom Cruise interview","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/i-never-made-movie-just-go-make-movie-it-was-always-exploration-filmmaking-our-world-exclusive-interview-with-tom-cruise","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P013","type":"filmmaker_quote","textZh":"纪录片是一所学习谦逊的学校。","author":"阿涅斯·瓦尔达","film":null,"character":null,"category":"纪录片","verification":"A","sourceTitle":"BFI｜Agnès Varda on The Gleaners and I","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/refuseniks-agnes-varda-gleaners-i","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P014","type":"filmmaker_quote","textZh":"我的计划，是用一只手去拍另一只手。","author":"阿涅斯·瓦尔达","film":null,"character":null,"category":"观看","verification":"B","sourceTitle":"BFI｜Agnès Varda / The Gleaners and I","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/critics-50-greatest-documentaries-all-time","sourceType":"影片旁白引录","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P015","type":"filmmaker_quote","textZh":"与其把它只看成技巧，不如把它看成人与人的连接。","author":"丹尼尔·关","film":null,"character":null,"category":"创作","verification":"A","sourceTitle":"BFI｜Daniels interviewed by Edgar Wright","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/daniel-kwan-daniel-scheinert-interviewed-edgar-wright","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P016","type":"filmmaker_quote","textZh":"我喜欢类型。","author":"约翰·卡朋特","film":null,"character":null,"category":"类型电影","verification":"A","sourceTitle":"BFI｜John Carpenter interview","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/john-carpenter-dark-star-assault-precinct-13","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P017","type":"filmmaker_quote","textZh":"在你拥有的限制中，把最好的作品做出来。","author":"达伦·阿伦诺夫斯基","film":null,"character":null,"category":"创作","verification":"A","sourceTitle":"DGA Quarterly｜Darren Aronofsky","sourceUrl":"https://www.dga.org/craft/dgaq/issues/1304-fall-2013/darren-aronofsky","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P018","type":"filmmaker_quote","textZh":"关键不在于能不能拍，而在于它值不值得被拍。","author":"凯瑟琳·毕格罗","film":null,"character":null,"category":"创作","verification":"A","sourceTitle":"DGA Quarterly｜Kathryn Bigelow","sourceUrl":"https://www.dga.org/craft/dgaq/issues/1704-fall-2017/dga-interview-kathryn-bigelow","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P019","type":"filmmaker_quote","textZh":"对我来说，如果观众注意到了风格，那就是坏的风格。","author":"西德尼·吕美特","film":null,"character":null,"category":"风格","verification":"A","sourceTitle":"DGA Quarterly｜Sidney Lumet","sourceUrl":"https://www.dga.org/craft/dgaq/issues/0703-fall-2007/interview-sidney-lumet","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P020","type":"filmmaker_quote","textZh":"这些人物本身，就是电影的音乐。","author":"大卫·O·拉塞尔","film":null,"character":null,"category":"人物","verification":"A","sourceTitle":"DGA Quarterly｜David O. Russell","sourceUrl":"https://www.dga.org/craft/dgaq/issues/1402-spring-2014/dga-interview-david-o-russell","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P021","type":"filmmaker_quote","textZh":"电影最初也是从市集与游乐场诞生的艺术。","author":"克莱尔·德尼","film":null,"character":null,"category":"电影史","verification":"A","sourceTitle":"BFI｜No Fear, No Die: Claire Denis","sourceUrl":"https://www.bfi.org.uk/interviews/no-fear-no-die-interview-claire-denis","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P022","type":"filmmaker_quote","textZh":"电影被预言死亡，已经预言了太久。","author":"卢卡·瓜达尼诺","film":null,"character":null,"category":"电影本体","verification":"A","sourceTitle":"BFI｜Luca Guadagnino: the future of film","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/luca-guadagnino-the-future-of-film","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P023","type":"filmmaker_quote","textZh":"电影在某种意义上，仍和1895年诞生时一样。","author":"彼得·格林纳威","film":null,"character":null,"category":"电影史","verification":"A","sourceTitle":"BFI｜In the beginning was the image: Peter Greenaway","sourceUrl":"https://www.bfi.org.uk/interviews/beginning-was-image-interview-with-peter-greenaway","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P024","type":"filmmaker_quote","textZh":"电影，是声音和画面一起在时间中运动。","author":"大卫·林奇","film":null,"character":null,"category":"电影本体","verification":"A","sourceTitle":"BFI｜David Lynch on music and sound","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/david-lynch-music-sound-chrystabell-cellophane-memories","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P025","type":"filmmaker_quote","textZh":"黑色有深度……你可以走进去。","author":"大卫·林奇","film":null,"character":null,"category":"视觉","verification":"B","sourceTitle":"BFI｜David Lynch in quotes","sourceUrl":"https://www.bfi.org.uk/features/david-lynch-quotes","sourceType":"权威整理","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P026","type":"filmmaker_quote","textZh":"电影才真正是我的召唤。","author":"理查德·林克莱特","film":null,"character":null,"category":"电影与生活","verification":"A","sourceTitle":"BFI｜Richard Linklater on Before Sunrise","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/features/first-kiss-takes-so-long-richard-linklater-before-sunrise","sourceType":"采访引录","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P027","type":"filmmaker_quote","textZh":"电影不只存在于精神世界，它也是一种生活方式。","author":"席琳·席安玛","film":null,"character":null,"category":"电影与生活","verification":"A","sourceTitle":"BFI｜Céline Sciamma on cinema utopia","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/dream-palaces/celine-sciamma-on-cinema-utopia","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P028","type":"filmmaker_quote","textZh":"你必须爱你的演员。","author":"玛格丽特·冯·特罗塔","film":null,"character":null,"category":"演员","verification":"A","sourceTitle":"BFI｜Margarethe von Trotta interview","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/margarethe-von-trotta-becoming-director-was-always-real-goal","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P029","type":"filmmaker_quote","textZh":"我想成为一个地下电影人。","author":"约翰·沃特斯","film":null,"character":null,"category":"电影与生活","verification":"A","sourceTitle":"BFI｜John Waters interviewed by Kim Morgan","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/john-waters-interviewed-kim-morgan","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P030","type":"filmmaker_quote","textZh":"电影，是每秒二十四次谎言。","author":"埃罗尔·莫里斯","film":null,"character":null,"category":"真相","verification":"A","sourceTitle":"DGA Quarterly｜Documentaries and DV","sourceUrl":"https://www.dga.org/craft/dgaq/issues/0601-spring-2006/features-documentaries-and-dv","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P031","type":"filmmaker_quote","textZh":"有些导演拍生活的切片，我拍蛋糕的切片。","author":"阿尔弗雷德·希区柯克","film":null,"character":null,"category":"类型电影","verification":"B","sourceTitle":"BFI｜10 great films that influenced Alfred Hitchcock","sourceUrl":"https://www.bfi.org.uk/lists/10-great-films-influenced-alfred-hitchcock","sourceType":"权威引录","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P032","type":"filmmaker_quote","textZh":"新现实主义不在于你拍什么，而在于你如何去看。","author":"罗伯托·罗西里尼","film":null,"character":null,"category":"现实与电影","verification":"B","sourceTitle":"BFI｜The roots of neorealism","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/features/roots-neorealism","sourceType":"权威引录","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P033","type":"filmmaker_quote","textZh":"电影曾让我看见一个我本来永远无法见到的世界。","author":"大卫·里恩","film":null,"character":null,"category":"观看","verification":"B","sourceTitle":"BFI｜Around the world with David Lean","sourceUrl":"https://www.bfi.org.uk/features/david-lean-place-odyssey","sourceType":"权威引录","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P034","type":"filmmaker_quote","textZh":"战争结束后，《红菱艳》告诉我们：去为艺术而死。","author":"迈克尔·鲍威尔","film":null,"character":null,"category":"艺术","verification":"B","sourceTitle":"BFI｜The Red Shoes at 70","sourceUrl":"https://www.bfi.org.uk/features/red-shoes-michael-powell-emeric-pressburger","sourceType":"回忆录引录","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P035","type":"filmmaker_quote","textZh":"我从没经营过一份事业，我只是拍电影。","author":"阿涅斯·瓦尔达","film":null,"character":null,"category":"电影与生活","verification":"B","sourceTitle":"Criterion｜The Restless Life and Oeuvre of Agnès Varda","sourceUrl":"https://www.criterion.com/current/posts/6276-the-restless-life-and-oeuvre-of-agnes-varda","sourceType":"采访引录","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P036","type":"filmmaker_quote","textZh":"我在电影里寻找的是启示——审美的、情感的、精神的启示。","author":"马丁·斯科塞斯","film":null,"character":null,"category":"电影本体","verification":"B","sourceTitle":"Criterion｜Scorsese and the State of the Art","sourceUrl":"https://www.criterion.com/current/posts/6673-scorsese-and-the-state-of-the-art","sourceType":"本人文章引录","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P037","type":"filmmaker_quote","textZh":"我们未必需要更多新电影，但我们需要连接，而电影是建立连接的强大媒介。","author":"丹尼斯·维伦纽瓦","film":null,"character":null,"category":"电影与生活","verification":"A","sourceTitle":"Toronto Film Critics Association｜Denis Villeneuve interview","sourceUrl":"https://torontofilmcritics.com/features/interview-denis-villeneuve-2/","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P038","type":"filmmaker_quote","textZh":"真正的回报，是能按自己想要的方式拍电影，而不必在创作上妥协。","author":"达米安·查泽雷","film":null,"character":null,"category":"创作","verification":"A","sourceTitle":"Glamour｜Whiplash movie secrets","sourceUrl":"https://www.glamour.com/story/whiplash-movie-secrets","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P039","type":"filmmaker_quote","textZh":"我们拍的不是说出来的东西，而是被藏起来的东西。","author":"王家卫","film":null,"character":null,"category":"人物与情感","verification":"A","sourceTitle":"BFI｜Wong Kar Wai on In the Mood for Love at 25","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/wong-kar-wai-mood-love-25","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P040","type":"filmmaker_quote","textZh":"最打动我的，是他抓住罪犯这份愿望里的纯粹。","author":"奉俊昊","film":null,"character":null,"category":"人物","verification":"A","sourceTitle":"BFI｜Bong Joon Ho on Memories of Murder","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/bong-joon-ho-memories-of-murder-2003-korean-cinema-breakthrough","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P041","type":"filmmaker_quote","textZh":"我开始想：电影能做什么？然后我意识到，剪辑就是关键。","author":"克里斯托弗·诺兰","film":null,"character":null,"category":"剪辑","verification":"A","sourceTitle":"BFI｜Christopher Nolan: a showman's odyssey","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/christopher-nolan-showmans-odyssey-oppenheimer","sourceType":"原始采访","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P042","type":"filmmaker_quote","textZh":"摄影机的语言，就是我们梦的语言。","author":"詹姆斯·鲍德温","film":null,"character":null,"category":"梦与电影","verification":"B","sourceTitle":"BFI｜bell hooks on cinema: a remembrance","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/features/bell-hooks-cinema-remembrance","sourceType":"著作引录","translationNote":"中文为收藏夹展示用自译/意译，不声称为官方译文。"},{"id":"P043","type":"filmmaker_quote","textZh":"没看过萨蒂亚吉特·雷伊的电影，就像活在世上却没见过太阳或月亮。","author":"黑泽明","film":null,"character":null,"category":"观看","verification":"B","sourceTitle":"BFI｜Satyajit Ray: a moral attitude","sourceUrl":"https://www.bfi.org.uk/sight-and-sound/interviews/satyajit-ray-moral-