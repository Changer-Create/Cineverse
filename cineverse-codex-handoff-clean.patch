       els.homeView.classList.toggle('hidden',name!=='home');els.libraryView.classList.toggle('hidden',name!=='library');els.detailView.classList.toggle('hidden',name!=='detail');els.matchView.classList.toggle('hidden',name!=='match');els.radarView.classList.toggle('hidden',name!=='radar');els.planView.classList.toggle('hidden',name!=='plan');els.watchedView.classList.toggle('hidden',name!=='watched');els.statsView.classList.toggle('hidden',name!=='stats');els.settingsView.classList.toggle('hidden',name!=='settings');
